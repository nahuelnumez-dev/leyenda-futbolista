{
  "name": "leyenda-futbolista",
  "private": true,
  "version": "1.3.0",
  "description": "Leyenda: Carrera de Futbolista — juego de decisiones sobre la carrera de un futbolista.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && VITE_CREST_PACK=1 vite build --outDir dist-web --emptyOutDir && rm -rf dist-web/crests && python3 scripts/pack-crests.py dist-web/crests-pack.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "vitest run src/data/data.test.ts",
    "balance": "vitest run src/engine/balance.test.ts --silent=false",
    "crests": "node scripts/fetch-crests.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "framer-motion": "^14.14.0",
    "html-to-image": "^1.11.11",
    "immer": "^11.2.10",
    "lz-string": "^1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
